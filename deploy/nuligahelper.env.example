# Copy to /etc/nuligahelper/web.env, replace every example value, and chmod 0600.
NULIGAHELPER_ENV=production
NULIGAHELPER_SECRET=REPLACE_WITH_A_STABLE_RANDOM_SECRET
NULIGAHELPER_DB=/var/lib/nuligahelper/nuliga_helper.db
NULIGAHELPER_TRUSTED_HOSTS=nuliga.example.invalid
# Optional single-line JSON override for auth-abuse policies. Omit for safe defaults.
# NULIGAHELPER_AUTH_ABUSE_CONFIG={"policies":{"sms_global_cap":{"limit":30,"window_seconds":86400}},"retention_seconds":604800,"cleanup_batch":200,"cleanup_interval_seconds":300,"trusted_proxies":[],"trusted_hops":0,"proxy_error":"fallback"}
