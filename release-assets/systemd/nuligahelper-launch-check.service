[Unit]
Description=nuLigaHelper launch check
After=network-online.target
Wants=network-online.target
OnFailure=nuligahelper-alert@monitor.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nuligahelper/current
EnvironmentFile=/etc/nuligahelper/web.env
ExecStartPre=/opt/nuligahelper/current/venv/bin/python -B -m nuligahelper.ops.runtime_check
ExecStart=/opt/nuligahelper/current/venv/bin/python -B -m nuligahelper.ops.monitoring launch-check
UMask=0077
TimeoutStartSec=20min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nuligahelper
RestrictSUIDSGID=true
