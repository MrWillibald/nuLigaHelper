# Copy to /etc/nuligahelper/web.env, replace every example value, and chmod 0600.
NULIGAHELPER_ENV=production
NULIGAHELPER_SECRET=REPLACE_WITH_A_STABLE_RANDOM_SECRET
NULIGAHELPER_DB=/var/lib/nuligahelper/nuliga_helper.db
NULIGAHELPER_TRUSTED_HOSTS=nuliga.example.invalid
# Optional single-line JSON override for auth-abuse policies. Omit for safe defaults.
# NULIGAHELPER_AUTH_ABUSE_CONFIG={"policies":{"sms_global_cap":{"limit":30,"window_seconds":86400}},"retention_seconds":604800,"cleanup_batch":200,"cleanup_interval_seconds":300,"trusted_proxies":[],"trusted_hops":0,"proxy_error":"fallback"}

# Shared by web, daily, cleanup, monitor and operator-alert units.
TZ=UTC
NULIGAHELPER_CONFIG=/etc/nuligahelper/config.json
NULIGAHELPER_OPERATIONS=/etc/nuligahelper/operations.json
NULIGAHELPER_STATE_DIR=/var/lib/nuligahelper
NULIGAHELPER_POLICY=/etc/nuligahelper/privacy-policy.json
NULIGAHELPER_LEGAL=/etc/nuligahelper/legal.json
NULIGAHELPER_LAUNCH=/etc/nuligahelper/launch.json

# Provider configuration. Replace every example value in the root-owned 0600 file.
# Quote values containing spaces or systemd EnvironmentFile special characters.
NULIGAHELPER_EMAIL_SMTP_SERVER=smtp.example.invalid
NULIGAHELPER_EMAIL_USER=sender@example.invalid
NULIGAHELPER_EMAIL_PASSWORD=REPLACE_EMAIL_PASSWORD
NULIGAHELPER_EMAIL_SENDER_NAME="Example Sender"
NULIGAHELPER_EMAIL_NEWSPAPER_RECIPIENT=paper@example.invalid
NULIGAHELPER_EMAIL_ADMIN_RECIPIENT=admin@example.invalid
NULIGAHELPER_EMAIL_SALE_USER=sale@example.invalid
NULIGAHELPER_EMAIL_SALE_PASSWORD=REPLACE_SALE_PASSWORD
NULIGAHELPER_TWILIO_ACCOUNT_SID=REPLACE_ACCOUNT_SID
NULIGAHELPER_TWILIO_AUTH_TOKEN=REPLACE_AUTH_TOKEN
NULIGAHELPER_TWILIO_SENDER_ID=REPLACE_SENDER_ID
NULIGAHELPER_TWILIO_SERVICE_SID=REPLACE_SERVICE_SID
NULIGAHELPER_DROPBOX_TOKEN=REPLACE_DROPBOX_TOKEN
NULIGAHELPER_DROPBOX_FOLDER="Example Folder"
NULIGAHELPER_DROPBOX_DATED_RETENTION=14
